# Copia este archivo como .env y ajusta los valores

# --- MySQL ---
BASE_DATOS_URL=mysql+pymysql://root:tu_clave@localhost:3306/campusstudy_tareas?charset=utf8mb4

# --- Primera entrega: los demás servicios aún no existen ---
SIMULAR_SERVICIOS=true
SIMULAR_NOTIFICACIONES_CAIDAS=false

# --- Segunda entrega: poner SIMULAR_SERVICIOS=false y ajustar las URLs reales ---
URL_USUARIOS=http://localhost:8008
URL_MATERIAS=http://localhost:8009
URL_GRUPOS=http://localhost:8002
URL_NOTIFICACIONES=http://localhost:8007

# --- Manejo de fallos (sección J del contrato) ---
TIMEOUT_SEGUNDOS=3
ESPERAS_REINTENTO=1,2
FALLOS_PARA_ABRIR_CIRCUITO=5
SEGUNDOS_CIRCUITO_ABIERTO=30
MINUTOS_REINTENTO_EVENTOS=5
HORAS_MAXIMO_EVENTO=24
